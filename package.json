{
    "name": "open-sfx-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.15.0",
    "scripts": {
        "build": "pnpm run build:napi && pnpm run build:ts",
        "build:ts": "pnpm --filter @wae/open-sfx run build",
        "build:napi": "node scripts/build-napi.mjs",
        "typecheck": "pnpm --filter @wae/open-sfx run typecheck",
        "verify": "node scripts/verify-install.mjs",
        "pack": "pnpm run build && node packages/open-sfx/dist/cli/main.js pack ./out"
    }
}
